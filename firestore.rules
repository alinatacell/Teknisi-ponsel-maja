rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuth(){return request.auth != null;}
    function myEmail(){return request.auth.token.email;}
    function myUid(){return request.auth.uid;}
    function isSuperAdmin(){return myEmail() == 'servicehpmaja@gmail.com';}
    function myUser(){return exists(/databases/$(database)/documents/users/$(myUid())) ? get(/databases/$(database)/documents/users/$(myUid())).data : null;}
    function myRole(){return myUser()!=null && myUser().keys().hasAny(['role']) ? myUser().role : '';}
    function isOwner(){return myRole()=='owner'||myRole()=='OWNER'||myRole()=='Owner';}
    function isAdmin(){return isSuperAdmin()||myRole()=='admin'||myRole()=='ADMIN'||myRole()=='superadmin'||myRole()=='SUPERADMIN'||myRole()=='SuperAdmin';}
    function isCommunityMember(){return isAuth()&&(isOwner()||myRole()=='karyawan'||myRole()=='employee'||isAdmin());}
    function isCommunityManager(){return isSuperAdmin()||isAdmin()||isOwner();}

    match /communityProducts/{id} {
      allow read: if isCommunityMember();
      allow create, update, delete: if isCommunityManager();
    }
    match /communityOrders/{id} {
      allow read: if isCommunityMember();
      allow create: if isCommunityMember() && request.resource.data.createdBy == myUid() && request.resource.data.status == 'menunggu';
      allow update: if isCommunityManager();
      allow delete: if false;
    }

    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
